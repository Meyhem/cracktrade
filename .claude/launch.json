{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "cracktrade-api", "serve"],
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "cracktrade-api", "worker"]
    }
  ]
}
