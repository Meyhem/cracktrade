# Copy to `.env` and edit. `.env` is git-ignored.
#
# Every value here is already the default in code or in docker-compose.yml, so an empty `.env`
# and no `.env` at all behave identically. The file exists to name what is configurable.

# ----------------------------------------------------------------- docker-compose.yml
# Read by compose when it starts the database container.
POSTGRES_USER=cracktrade
POSTGRES_PASSWORD=cracktrade
POSTGRES_DB=cracktrade

# Host port the database is published on. Change this if 5432 is already taken locally --
# and change CRACKTRADE_API_DATABASE_URL below to match.
CRACKTRADE_DB_PORT=5432

# ----------------------------------------------------------------- the API and the worker
# Read by ApiSettings (src/cracktrade/api/settings.py).
CRACKTRADE_API_DATABASE_URL=postgresql://cracktrade:cracktrade@localhost:5432/cracktrade
CRACKTRADE_API_HOST=127.0.0.1
CRACKTRADE_API_PORT=8000

# ----------------------------------------------------------------- tests
# Where the db-marked tests look for a server. Defaults to the compose database above, so
# normally you do not need this. Those tests create and drop their own databases on that
# server; they never touch the one named in the URL.
# CRACKTRADE_API_TEST_DATABASE_URL=postgresql://cracktrade:cracktrade@localhost:5432/postgres

# Set to 1 to make db-marked tests FAIL instead of skip when no server is reachable. Use it in
# CI: a suite that skips its integration tests reports green while proving nothing.
# CRACKTRADE_API_TEST_DB_REQUIRED=1

# ----------------------------------------------------------------- the engine
# Engine settings use the CRACKTRADE_ prefix (no API). They change computed results, so they
# are deliberately not something the interface layer sets.
# CRACKTRADE_SEED=0
# CRACKTRADE_CACHE_ENABLED=false
